# Export these variables in your terminal or host settings; .env is not auto-loaded.
# Local accounts default to .local/winddesk-auth.sqlite3. Docker uses a named volume.
# AUTH_DB_PATH=/absolute/writable/path/winddesk.sqlite3
# Vercel accounts REQUIRE external PostgreSQL. Use the provider's TLS connection URL.
# DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require
# AUTH_COOKIE_SECURE=true
# Optional exact origins, comma-separated, if your HTTPS proxy changes the origin:
# AUTH_ALLOWED_ORIGINS=https://YOUR_APP.vercel.app
# The two public Elexon datasets require no API key.
